{
  "name": "knowledge-base-ai-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:reset": "tsx scripts/dev-reset.ts",
    "build": "turbo build",
    "typecheck": "tsc --noEmit --project tsconfig.scripts.json && turbo typecheck",
    "lint": "eslint scripts/*.ts && turbo lint",
    "format": "prettier --write .",
    "test": "vitest run scripts/*.test.ts && turbo test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @kb/db db:migrate",
    "db:generate": "pnpm --filter @kb/db db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mindfoldhq/trellis": "^0.6.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
