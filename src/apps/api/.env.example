PORT=4000
SERVICE_NAME=api
NODE_ENV=development
LOG_LEVEL=info

APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

DATABASE_URL=
# Local Docker Compose Redis. The API owns rate-limit storage; browser code must not connect to Redis.
REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

BETTER_AUTH_SECRET=
APP_ENCRYPTION_KEY=

WORKER_CONCURRENCY=

INGESTION_QUEUE_ATTEMPTS=3
INGESTION_QUEUE_BACKOFF_MS=5000
INGESTION_REQUEUE_STALE_AFTER_MS=300000
INGESTION_REQUEUE_BATCH_SIZE=100
INGESTION_PARSER_CONCURRENCY=2
INGESTION_EMBEDDING_CONCURRENCY=1
INGESTION_INDEX_CONCURRENCY=1
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=150

UPLOAD_MAX_FILE_BYTES=8388608
UPLOAD_REQUEST_OVERHEAD_BYTES=65536
UPLOAD_RATE_LIMIT_PER_MINUTE=20
UPLOAD_CONCURRENCY_PER_ACTOR=2
UPLOAD_CONCURRENCY_PER_TENANT=10
